# ---------- Telegram ----------
# @BotFather dan olingan token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Mini App ochiladigan HTTPS manzil (BotFather -> /setmenubutton da ham shu manzil)
WEBAPP_URL=https://luqma.example.uz

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ---------- Ma'lumotlar bazasi ----------
# SQLite (default). PostgreSQL ga o'tish uchun:
# DATABASE_URL=postgresql+asyncpg://user:parol@db:5432/luqma
DATABASE_URL=sqlite+aiosqlite:///./data/luqma.db

# ---------- API ----------
# Vergul bilan ajratilgan origin'lar yoki * (nginx orqasida bo'lsa * yetarli)
CORS_ORIGINS=*
MEDIA_DIR=./data/media
# initData ning maksimal yoshi, sekundda (24 soat). 0 = tekshirilmaydi
INITDATA_MAX_AGE=86400

# ---------- Ishlab chiqish ----------
# TRUE bo'lsa initData tekshirilmaydi — PRODUCTIONDA ALBATTA false BO'LSIN!
DEV_MODE=false
DEV_TELEGRAM_ID=111111111

# ---------- Deploy (docker-compose) ----------
# HTTPS sertifikat uchun domen va email
DOMAIN=luqma.example.uz
CERTBOT_EMAIL=admin@example.uz

# --- Vaqt zonasi ---
# "Bugun" qachon boshlanishini belgilaydi. Bo'sh qoldirilsa Asia/Tashkent.
TZ=Asia/Tashkent

# --- Kunlik chegaralar (bitta foydalanuvchi uchun) ---
# Har AI chaqiruvi OpenAI hisobidan pul yechadi — chegarasiz qoldirmang.
TAHLIL_KUNLIK_LIMIT=30
CHAT_KUNLIK_LIMIT=30

# Rasmlar shuncha kundan keyin diskdan o'chiriladi (0 = o'chirilmaydi).
RASM_SAQLASH_KUNI=60

# --- Admin ---
# O'z Telegram ID ingiz (bir nechta bo'lsa vergul bilan). Bo'sh = admin yo'q.
ADMIN_IDS=

# --- Premium chegaralari ---
PREMIUM_TAHLIL_KUNLIK_LIMIT=200
PREMIUM_CHAT_KUNLIK_LIMIT=200

# Butun ilova bo'yicha kunlik AI chaqiruvlari chegarasi (0 = cheklanmagan).
# Bitta foydalanuvchi chegarasi hisobni himoya qilmaydi: 1000 odam x 30 = katta summa.
UMUMIY_KUNLIK_LIMIT=5000

# --- Loglar ---
LOG_LEVEL=INFO
# Bo'sh = faqat konsol. Docker da /data/logs/luqma.log tavsiya etiladi.
LOG_FILE=/data/logs/luqma.log

# --- Chek yuborish ---
# Kuniga nechta chek yuborish mumkin (spamdan himoya).
CHEK_KUNLIK_LIMIT=5
